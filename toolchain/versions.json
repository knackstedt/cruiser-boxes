{
  "comment": "Pinned build-from-source toolchain. `cruiser toolchain build` fetches+builds into opt/; `check` reports what resolves. sha256 fields are pinned after first verified fetch — record-on-download, verify-on-reuse.",
  "order": ["meson", "spice-protocol", "spice-server", "virglrenderer", "qemu", "waypipe", "freerdp"],
  "components": {
    "meson": {
      "version": "1.12.0",
      "url": "https://github.com/mesonbuild/meson/releases/download/1.12.0/meson-1.12.0.tar.gz",
      "kind": "tool",
      "why": "system meson <1.5 is too old for QEMU 11"
    },
    "spice-protocol": {
      "version": "0.14.5",
      "url": "https://gitlab.freedesktop.org/spice/spice-protocol/-/archive/v0.14.5/spice-protocol-v0.14.5.tar.gz",
      "dir": "spice-protocol-v0.14.5",
      "sha256": "1be179b3dfbb23946432275f4b7a4b59bb5e9acc25c3128bc930b8264a9f0a20",
      "kind": "meson",
      "prefix": "spice",
      "mesonArgs": [],
      "why": "headers for spice-server/QEMU"
    },
    "spice-server": {
      "version": "0.16.0",
      "url": "https://www.spice-space.org/download/releases/spice-server/spice-0.16.0.tar.bz2",
      "kind": "meson",
      "prefix": "spice",
      "mesonArgs": ["-Dgstreamer=1.0", "-Dsasl=false"],
      "pkgConfigPath": ["spice/lib/x86_64-linux-gnu/pkgconfig", "spice/share/pkgconfig"],
      "why": "distro 0.15.1 lacks remote-client GL; QEMU links it"
    },
    "virglrenderer": {
      "version": "1.3.0",
      "url": "https://gitlab.freedesktop.org/virgl/virglrenderer/-/archive/1.3.0/virglrenderer-1.3.0.tar.gz",
      "kind": "meson",
      "prefix": "virglrenderer",
      "mesonArgs": ["-Dvenus=true"],
      "pkgConfigPath": ["virglrenderer/lib/x86_64-linux-gnu/pkgconfig"],
      "why": "distro build has no Venus exports (no Vulkan passthrough)"
    },
    "qemu": {
      "version": "11.1.1",
      "url": "https://download.qemu.org/qemu-11.1.1.tar.xz",
      "kind": "qemu",
      "prefix": "qemu-11",
      "patches": ["qemu-11.1.1-dbus-refresh-10ms.patch"],
      "configureArgs": [
        "--target-list=x86_64-softmmu",
        "--enable-kvm", "--enable-slirp", "--enable-gtk", "--enable-opengl",
        "--enable-virglrenderer", "--enable-spice", "--enable-seccomp",
        "--enable-capstone", "--disable-docs"
      ],
      "why": "distro 8.2.2 GL module is broken (qemu_egl_display) and too old for Venus"
    },
    "waypipe": {
      "version": "0.11.2",
      "url": "https://gitlab.freedesktop.org/mstoeckl/waypipe/-/archive/v0.11.2/waypipe-v0.11.2.tar.gz",
      "dir": "waypipe-v0.11.2",
      "kind": "meson",
      "prefix": "waypipe",
      "mesonArgs": ["-Dwith_video=disabled", "-Dwith_dmabuf=enabled", "-Dwith_lz4=enabled", "-Dwith_zstd=enabled"],
      "optional": true,
      "aptAlternative": "waypipe",
      "why": "app-only head mode transport; distro package is usually sufficient"
    },
    "freerdp": {
      "version": "3.32.1",
      "url": "https://github.com/FreeRDP/FreeRDP/archive/refs/tags/3.32.1.tar.gz",
      "kind": "cmake",
      "prefix": "freerdp",
      "dir": "FreeRDP-3.32.1",
      "sha256": "8803dd26ec9660550252f255cf2d672a785ddd8f544bb475834993e96807c87f",
      "optional": true,
      "aptAlternative": "freerdp3-x11",
      "systemFloor": "3.5.0",
      "cmakeArgs": [
        "-DWITH_SERVER=OFF", "-DWITH_SAMPLE=OFF", "-DWITH_MANPAGES=OFF",
        "-DWITH_CLIENT_SDL=OFF", "-DWITH_KRB5=OFF", "-DWITH_CUPS=OFF", "-DWITH_FUSE=OFF",
        "-DCHANNEL_URBDRC=OFF",
        "-DWITH_GFX_H264=ON",
        "-DWITH_FFMPEG=ON", "-DWITH_DSP_FFMPEG=ON", "-DWITH_VIDEO_FFMPEG=ON",
        "-DWITH_SWSCALE=ON"
      ],
      "why": "viewer for all desktop head modes; distro freerdp3 has no H.264, which krdp (KDE guests) requires — build even when the system floor is met"
    }
  },
  "systemTools": {
    "xfreerdp3": { "floor": "3.5.0", "pkg": "freerdp3-x11", "versionFlag": "--version" },
    "virtiofsd": { "pkg": "virtiofsd", "why": "preferred host-share backend (9p fallback)" },
    "cloud-localds": { "pkg": "cloud-image-utils", "why": "NoCloud seed.iso for cloud-image provisioning" },
    "wmctrl": { "pkg": "wmctrl", "why": "X11 window placement" },
    "xdotool": { "pkg": "xdotool", "why": "X11 window search/placement" },
    "qdbus": { "pkg": "qdbus / qt6-tools", "why": "KDE integration (KWin rules, desktops)" },
    "genisoimage": { "pkg": "genisoimage|xorriso", "why": "seed.iso creation fallback" },
    "socat": { "pkg": "socat", "why": "socket plumbing helper (optional)" }
  },
  "aptBuildDeps": [
    "build-essential", "pkg-config", "ninja-build", "python3-pip", "python3-setuptools",
    "python3-venv", "liblz4-dev",
    "libglib2.0-dev", "libpixman-1-dev", "libslirp-dev", "libepoxy-dev", "libgbm-dev",
    "libdrm-dev", "libvulkan-dev", "libgtk-3-dev", "libseccomp-dev", "libcapstone-dev",
    "libcap-ng-dev", "libzstd-dev", "zlib1g-dev", "libaio-dev", "liburing-dev",
    "libgstreamer1.0-dev", "libgstreamer-plugins-base1.0-dev",
    "ovmf", "virt-viewer",
    "cmake", "libssl-dev", "libx11-dev", "libxext-dev", "libxinerama-dev",
    "libxrandr-dev", "libxi-dev", "libxfixes-dev", "libxcursor-dev",
    "libxkbfile-dev", "libxrender-dev", "libxtst-dev", "libxss-dev",
    "libasound2-dev", "libpulse-dev", "libcups2-dev", "libpcsclite-dev",
    "libusb-1.0-0-dev", "libavcodec-dev", "libavutil-dev", "libswscale-dev",
    "libswresample-dev"
  ]
}
