{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types", "vite/client", "node"],
    "paths": {
      "xxh3-ts": ["../downdraft-engine/packages/engine/libraries/persistence/src/xxh3-ts.d.ts"]
    }
  },
  "include": ["src", "libraries", "modules", "toolchain", "*.ts", "*.mts"]
}
