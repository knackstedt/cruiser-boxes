#!/usr/bin/env bun
// ============================================================================
// build-term-page.mts — bundle the xterm.js terminal page into a TS module.
//
// `bun build` emits page-entry.ts (xterm + fit addon) as a single js file
// plus the extracted css; both are inlined into term-bundle.gen.ts as
// string exports so the webui view gets a self-contained page — no URL,
// no node_modules, works identically under dev and `bun build --compile`.
//
// Run: bun run term:bundle
// ============================================================================

import { spawnSync } from "node:child_process";
import { mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const entry = join(root, "libraries/app-shell/src/term/page-entry.ts");
const outdir = join(root, ".term-bundle-out");
mkdirSync(outdir, { recursive: true });

const r = spawnSync("bun", ["build", entry, "--format=iife", "--outdir", outdir],
    { cwd: root, encoding: "utf-8" });
if (r.status !== 0) {
    console.error(r.stderr);
    process.exit(r.status ?? 1);
}

const js = readFileSync(join(outdir, "page-entry.js"), "utf-8");
const css = readFileSync(join(outdir, "page-entry.css"), "utf-8");

const esc = (s: string) => JSON.stringify(s);
const gen = `// ============================================================================
// term-bundle.gen.ts — GENERATED by toolchain/build-term-page.mts.
// Do not edit by hand; regenerate with \`bun run term:bundle\`.
// ============================================================================

export const TERM_JS = ${esc(js)};
export const TERM_CSS = ${esc(css)};
`;

writeFileSync(join(root, "libraries/app-shell/src/term/term-bundle.gen.ts"), gen);
rmSync(outdir, { recursive: true, force: true });
console.log(`term-bundle.gen.ts written (${js.length} B js, ${css.length} B css)`);
